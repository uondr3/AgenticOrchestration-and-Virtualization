# Copia este archivo como .env y escribe los nombres reales de Tailscale.
# .env no se publica.

# Estaciones a medir, separadas por coma, con el formato nombre visible=host:puerto
OBS_TARGETS="Estación Revit=pc-revit:9182,Estación 3ds Max=pc-max:9182"

# Cuánto historial guarda Prometheus
OBS_RETENCION="90d"

# Puerto de OhmGraphite (temperatura del procesador) en cada estación
OBS_PUERTO_SENSORES="4445"

# "si" permite ver Grafana sin contraseña, solo desde esta Mac (127.0.0.1) y en modo lectura
OBS_VISTA_ANONIMA="no"

# Alertas por correo con Gmail. Requiere una contraseña de aplicación:
# https://myaccount.google.com/apppasswords  (la cuenta necesita verificación en dos pasos)
OBS_SMTP_USUARIO=""          # cuenta de Gmail que envía
OBS_SMTP_CLAVE=""            # contraseña de aplicación de 16 letras
OBS_ALERTA_CORREO=""         # quién recibe; vacío = la misma cuenta. Varias separadas por ;
OBS_HORA_INICIO="09:00"      # fuera de este horario y en fin de semana las alertas se silencian
OBS_HORA_FIN="19:00"
OBS_ZONA="America/Merida"
