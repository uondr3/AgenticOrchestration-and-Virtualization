# Copia este archivo como .env y escribe los nombres reales de Tailscale.
# .env no se publica.

# Estaciones a medir, separadas por coma, con el formato nombre visible=host:puerto
OBS_TARGETS="Estación Revit=pc-revit:9182,Estación 3ds Max=pc-max:9182"

# Cuánto historial guarda Prometheus
OBS_RETENCION="90d"
